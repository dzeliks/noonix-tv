# Maintainer: dzeliks <127214601+dzeliks@users.noreply.github.com>
pkgname=noonix-tv-bin
_name=noonix-tv
pkgver=0.6.0
pkgrel=1
pkgdesc='Movies and shows on the TV, made for a remote or a controller (release build)'
arch=(x86_64 aarch64)
url='https://github.com/dzeliks/noonix-tv'
license=(GPL-3.0-or-later)
depends=(glibc libglvnd fontconfig hicolor-icon-theme)
provides=($_name)
conflicts=($_name)
options=(!strip !debug)
source_x86_64=("$url/releases/download/v$pkgver/Noonix-TV-$pkgver-x86_64.AppImage")
source_aarch64=("$url/releases/download/v$pkgver/Noonix-TV-$pkgver-aarch64.AppImage")
noextract=("Noonix-TV-$pkgver-$CARCH.AppImage")
sha256sums_x86_64=('ad1b01ec9b2393f0c580b553d844d16365187bf3dd2af32e2c3fb6605dec5ede')
sha256sums_aarch64=('8dd56c5d55bea35f08aff01cd2c8e7a8abe272e924d6568e7298c239e6449ba9')

prepare() {
    chmod +x Noonix-TV-$pkgver-$CARCH.AppImage
    rm -rf squashfs-root
    ./Noonix-TV-$pkgver-$CARCH.AppImage --appimage-extract >/dev/null
}

package() {
    # the app updates through pacman here: its own updater only runs inside an appimage
    install -d "$pkgdir/opt/$_name" "$pkgdir/usr/bin"
    cp -a squashfs-root/. "$pkgdir/opt/$_name/"
    rm -f "$pkgdir/opt/$_name/.DirIcon"
    chmod -R u=rwX,go=rX "$pkgdir/opt/$_name"
    ln -s /opt/$_name/AppRun "$pkgdir/usr/bin/$_name"
    install -Dm644 squashfs-root/$_name.desktop "$pkgdir/usr/share/applications/$_name.desktop"
    sed -i '/^X-AppImage/d' "$pkgdir/usr/share/applications/$_name.desktop"
    install -Dm644 -t "$pkgdir/usr/share/icons/hicolor/scalable/apps" \
        squashfs-root/usr/share/icons/hicolor/scalable/apps/*.svg
    install -d "$pkgdir/usr/share/licenses/$pkgname"
    ln -s /opt/$_name/usr/share/licenses/$_name/LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
